{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix-unbound.local/schemas/capability-registry.schema.json",
  "title": "Phoenix Unbound Peer Capability Registry",
  "description": "A non-hierarchical registry of repositories, model components, skills, services, and evidence nodes.",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "source",
        "status",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$"
        },
        "kind": {
          "enum": [
            "repository",
            "model",
            "skill",
            "service",
            "dataset",
            "interface",
            "evidence",
            "infrastructure"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "organ_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "license": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "discovered",
            "inventoried",
            "contracted",
            "connected",
            "verified",
            "quarantined",
            "retired"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "healthcheck": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "contract",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "transport": {
          "enum": [
            "in_process",
            "stdio",
            "http",
            "websocket",
            "a2a",
            "event",
            "file"
          ]
        },
        "authentication": {
          "type": "string"
        },
        "authorization_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "proposed",
            "validated",
            "enabled",
            "degraded",
            "disabled"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
