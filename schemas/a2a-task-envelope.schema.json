{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zygros/conzet-sovereign-intelligence/blob/main/schemas/a2a-task-envelope.schema.json",
  "title": "Sovereign Conzetian A2A Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "task_id",
    "sender",
    "recipient",
    "task_type",
    "created_at",
    "permissions",
    "payload",
    "provenance"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes",
        "sensitive_action_confirmation"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sensitive_action_confirmation": {
          "type": "boolean"
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "uri"
        ],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_refs",
        "producer",
        "schema_version"
      ],
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "1.0"
        },
        "repository_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "submitted",
        "accepted",
        "running",
        "completed",
        "failed",
        "rejected",
        "timed_out",
        "cancelled"
      ]
    }
  }
}
